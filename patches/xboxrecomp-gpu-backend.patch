+        s = s_const[ci];
+        break;
+    }
+    }
+    r.v[0] = s[d->sw[0]];
+    r.v[1] = s[d->sw[1]];
+    r.v[2] = s[d->sw[2]];
+    r.v[3] = s[d->sw[3]];
+    if (d->neg) {
+        r.v[0] = -r.v[0]; r.v[1] = -r.v[1];
+        r.v[2] = -r.v[2]; r.v[3] = -r.v[3];
