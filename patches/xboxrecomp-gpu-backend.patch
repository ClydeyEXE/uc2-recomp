+    pd.vertex_count = hi - lo + 1;
+    pd.aa[0] = s_gpu.aa_sx;
+    pd.aa[1] = s_gpu.aa_sy;
+    pd.fog_enable = s_gpu.fog_enable;
+    pd.fog_mode = s_gpu.fog_mode;
+    pd.fog_param[0] = s_gpu.fog_param[0];
+    pd.fog_param[1] = s_gpu.fog_param[1];
