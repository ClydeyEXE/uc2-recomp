+/* The guest core to the guest threads. Pinning them says where they run, not
+ * that nothing else does: the GPU executor, its vertex workers and the device
+ * threads went wherever the scheduler put them, the guest core and its
+ * hyperthread sibling included, and in a UC2 match the guest core sat at 100%
+ * with the title's main thread the limit. The process's default CPU sets now
+ * leave out the whole physical core; the pinned threads' affinity masks still
+ * put them on it. RECOMP_GUEST_CORE_SHARED=1 leaves the core open, as before. */
+static void guest_core_reserve(int cpu)
+{
+    const char *e = getenv("RECOMP_GUEST_CORE_SHARED");
+    ULONG len = 0, n = 0, total = 0, ids[256];
+    BYTE core = 0;
+    int found = 0;
+    char *buf, *p;
+
+    if (e && *e && *e != '0')
+        return;
+    GetSystemCpuSetInformation(NULL, 0, &len, GetCurrentProcess(), 0);
+    if (!len || !(buf = (char *)malloc(len)))
+        return;
+    if (GetSystemCpuSetInformation((PSYSTEM_CPU_SET_INFORMATION)buf, len, &len, GetCurrentProcess(), 0)) {
+        for (p = buf; p < buf + len; p += ((PSYSTEM_CPU_SET_INFORMATION)p)->Size) {
+            PSYSTEM_CPU_SET_INFORMATION s = (PSYSTEM_CPU_SET_INFORMATION)p;
+            if (s->Type == CpuSetInformation && s->CpuSet.Group == 0
+                && s->CpuSet.LogicalProcessorIndex == cpu) {
+                core = s->CpuSet.CoreIndex;
+                found = 1;
+            }
+        }
+        for (p = buf; found && p < buf + len; p += ((PSYSTEM_CPU_SET_INFORMATION)p)->Size) {
+            PSYSTEM_CPU_SET_INFORMATION s = (PSYSTEM_CPU_SET_INFORMATION)p;
+            if (s->Type != CpuSetInformation)
+                continue;
+            total++;
+            if (!(s->CpuSet.Group == 0 && s->CpuSet.CoreIndex == core) && n < 256)
+                ids[n++] = s->CpuSet.Id;
+        }
+    }
+    free(buf);
+    if (!found || !n || n == total)
+        return;
+    if (SetProcessDefaultCpuSets(GetCurrentProcess(), ids, n))
+        fprintf(stderr, "  [KERNEL] other threads kept off the guest core (cpu %d and its"
+                        " sibling): %lu of %lu logical cpus\n", cpu, n, total);
