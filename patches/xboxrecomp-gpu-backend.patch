+    gpu_vsh_check(&pd, n);
+    current_surface(&surf);
+    current_render_state(&rs);
+    fill_shading(&sh, 1);
+    memset(&batch, 0, sizeof batch);
+    batch.count = pd.vertex_count;
+    batch.state = &rs;
+    batch.shading = &sh;
+    batch.indices = s_gidx;
+    batch.index_count = icount;
+    batch.program = &pd;
+    if (!s_backend->draw_program(&surf, &batch)) {
