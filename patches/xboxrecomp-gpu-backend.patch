+    if (!s_dec_n)
+        return vsh_run_reference(in, out);
+    if (check < 0)
+        check = getenv("RECOMP_VSH_CHECK") != NULL;
+    if (!vsh_run_decoded(in, out))
+        return 0;
+    /* A program that writes constants would write them twice. */
+    if (check && !s_cxt_write) {
+        Nv2aVshOutput ref;
+        vsh_run_reference(in, &ref);
+        checked++;
+        if (memcmp(&ref, out, sizeof ref) && differ++ < 8)
+            fprintf(stderr, "[VSH] check: vertex differs from the reference (program at slot %u,"
+                            " pos %g %g %g %g against %g %g %g %g)\n", s_start_slot,
+                    out->pos[0], out->pos[1], out->pos[2], out->pos[3],
+                    ref.pos[0], ref.pos[1], ref.pos[2], ref.pos[3]);
+        if ((checked & 0xFFFFF) == 0)
+            fprintf(stderr, "[VSH] check: %lu vertices, %lu differ\n", checked, differ);
+    }
+    return 1;
+}
