+    }
+    if (!d->ident)
+        em(e, ".%c%c%c%c", sw[d->sw[0]], sw[d->sw[1]], sw[d->sw[2]], sw[d->sw[3]]);
+}
+
+int nv2a_vsh_program_hash(uint64_t *hash)
+{
+    if (!s_dec_valid || s_dec_rev != s_program_revision)
+        dec_program();
+    if (hash)
+        *hash = s_dec_hash;
+    return s_dec_final;
+}
+
+/* The inputs the program reads, bit i for v[i]. */
+static uint32_t dec_inputs(void)
+{
+    uint32_t i, used = 0;
+    int k;
+
+    for (i = 0; i < s_dec_count; i++)
+        for (k = 0; k < 3; k++)
+            if ((s_dec[i].reads >> k & 1) && s_dec[i].src[k].mux == DEC_INPUT)
+                used |= 1u << s_dec[i].src[k].idx;
+    return used;
+}
+
+uint32_t nv2a_vsh_program_inputs(void)
+{
+    static uint32_t rev = ~0u, used;
+
+    if (!nv2a_vsh_program_hash(NULL))
+        return 0;
+    if (rev != s_dec_rev) {
+        used = dec_inputs();
+        rev = s_dec_rev;
+    }
+    return used;
+}
+
+size_t nv2a_vsh_emit_hlsl(char *buf, size_t cap)
+{
+    static const char *const mac_expr[16] = {
+        "A", "A", "A * B", "A + C", "A * B + C",
+        "dot(A.xyz, B.xyz).xxxx", "(dot(A.xyz, B.xyz) + B.w).xxxx", "dot(A, B).xxxx",
+        "float4(1, A.y * B.y, A.z, B.w)", "vmin(A, B)", "vmax(A, B)",
+        "float4(A < B)", "float4(A >= B)", "A", "A", "A"
+    };
+    static const char *const ilu_expr[8] = {
+        "C", "C", "(1.0 / C.x).xxxx", "ilu_rcc(C.x)", "(1.0 / sqrt(abs(C.x))).xxxx",
+        "ilu_exp(C.x)", "ilu_log(C.x)", "ilu_lit(C)"
+    };
+    Emit e;
+    uint32_t i, used;
+
+    if (!buf || !cap || !nv2a_vsh_program_hash(NULL))
+        return 0;
+    e.p = buf; e.n = 0; e.cap = cap;
+    buf[0] = 0;
+    used = dec_inputs();
+
+    em(&e, "void vsh(uint vid, out float4 P, out float4 O[13]) {\n");
+    em(&e, "  float4 R0 = 0, R1 = 0, R2 = 0, R3 = 0, R4 = 0, R5 = 0;\n"
+           "  float4 R6 = 0, R7 = 0, R8 = 0, R9 = 0, R10 = 0, R11 = 0;\n"
+           "  int a0 = 0;\n  P = 0;\n");
+    /* vsh_init_regs: colours opaque, texture q 1. */
+    em(&e, "  [unroll] for (uint k = 0; k < 13; k++) O[k] = 0;\n"
+           "  O[3].w = 1; O[4].w = 1; O[9].w = 1; O[10].w = 1; O[11].w = 1; O[12].w = 1;\n");
+    for (i = 0; i < NV2A_VSH_INPUTS; i++)
+        if (used >> i & 1)
+            em(&e, "  float4 v%u = vin(%u, vid);\n", i, i);
+
+    for (i = 0; i < s_dec_count; i++) {
+        const DecIns *d = &s_dec[i];
+        char m[5];
+
+        em(&e, "  { /* %u */\n", i);
+        em(&e, "    float4 A = 0, B = 0, C = 0, M = 0, I = 0;\n");
+        if (d->reads & 1) { em(&e, "    A = "); em_src(&e, &d->src[0]); em(&e, ";\n"); }
+        if (d->reads & 2) { em(&e, "    B = "); em_src(&e, &d->src[1]); em(&e, ";\n"); }
+        if (d->reads & 4) { em(&e, "    C = "); em_src(&e, &d->src[2]); em(&e, ";\n"); }
+        if (d->mac == 13)
+            em(&e, "    a0 = (int)floor(A.x + 0.001);\n    M = A;\n");
+        else if (d->mac)
+            em(&e, "    M = %s;\n", mac_expr[d->mac]);
+        if (d->ilu)
+            em(&e, "    I = %s;\n", ilu_expr[d->ilu & 7]);
+        if (d->mac_mask && d->mac_dst != DEC_NO_DST) {
+            em_mask(m, d->mac_mask);
+            if (d->mac_dst == 12)
+                em(&e, "    P.%s = M.%s;\n", m, m);
+            else
+                em(&e, "    R%u.%s = M.%s;\n", d->mac_dst, m, m);
+        }
+        if (d->ilu_mask && d->ilu_dst != DEC_NO_DST) {
+            em_mask(m, d->ilu_mask);
+            if (d->ilu_dst == 12)
+                em(&e, "    P.%s = I.%s;\n", m, m);
+            else
+                em(&e, "    R%u.%s = I.%s;\n", d->ilu_dst, m, m);
+        }
+        /* Writes to c[] (to_o clear) need _CXT_WRITE_EN, which a caller keeps on
+         * the CPU; without it they are dropped, as there. */
+        if (d->omask && d->to_o && d->oaddr < 13) {
+            em_mask(m, d->omask);
+            if (d->oaddr == 0)
+                em(&e, "    P.%s = %c.%s;\n", m, d->from_ilu ? 'I' : 'M', m);
+            else
+                em(&e, "    O[%u].%s = %c.%s;\n", d->oaddr, m, d->from_ilu ? 'I' : 'M', m);
+        }
+        em(&e, "  }\n");
+        if (d->final)
+            break;
+    }
+    em(&e, "}\n");
+    return e.n < e.cap ? e.n : 0;
+}
