+ * Stays on the CPU: fixed-function and screen-space batches, programs that
+ * write constants (_CXT_WRITE_EN: their result depends on vertex order), and
+ * any batch the back end turns down (its shader is still compiling, say).
+ * On whenever the back end offers it; RECOMP_GPU_VSH=0 keeps every batch on the CPU. */
+static uint32_t *s_gidx;                       /* the triangle list, from first */
+static uint64_t  s_gpu_vsh_batches, s_gpu_vsh_fallback;
