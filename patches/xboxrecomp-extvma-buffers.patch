diff --git a/src/kernel/guest_vmem.c b/src/kernel/guest_vmem.c
index 24b948e..d434fe7 100644
--- a/src/kernel/guest_vmem.c
+++ b/src/kernel/guest_vmem.c
@@ -305,6 +305,26 @@ int guest_vmem_free(uint32_t *base, uint32_t *size, uint32_t free_type,
     return handled;
 }
 
+int guest_vmem_committed(uint32_t va, uint32_t bytes)
+{
+    uint64_t end = (uint64_t)va + bytes;
+    uint32_t p, last;
+    int ok = 1;
+
+    if (!s_pages || !bytes || va < s_lo || end > s_top)
+        return 0;
+    last = page_index((uint32_t)(end - 1));
+    AcquireSRWLockShared(&s_lock);
+    for (p = page_index(va); p <= last; ++p) {
+        if (s_pages[p].state != MEM_COMMIT_FLAG) {
+            ok = 0;
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&s_lock);
+    return ok;
+}
+
 /* A region nothing can be allocated in, reported as reserved. */
 static void reserved_region(uint32_t info[7], uint32_t lo, uint32_t hi)
 {
