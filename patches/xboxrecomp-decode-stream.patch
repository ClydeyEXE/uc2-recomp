+def decode_stream(cs, code, va, window=512):
+    """Yield what cs.disasm(code, va) yields, decoding one window at a time.
+
+    cs.disasm decodes its whole buffer before returning the first instruction,
+    so a caller that stops after a few instructions still pays for the rest of
+    the section. An x86 instruction is at most 15 bytes: a window that stops
+    with 15 or more bytes left has hit invalid code, which ends the stream as
+    it would have in one call. Fewer than that may be an instruction cut by the
+    window, so decoding resumes from there.
+    """
+    offset = 0
+    while offset < len(code):
+        chunk = code[offset:offset + window]
+        used = 0
+        for insn in cs.disasm(chunk, va + offset):
+            used += insn.size
+            yield insn
+        offset += used
+        if used == 0 or len(chunk) - used >= 15:
+            return
+
